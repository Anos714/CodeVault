# CodeVault environment variables
#
# Copy this to .env.local and fill it in. `bun` and `next dev` both read
# .env.local automatically — never commit real values.

# ---- Neon Postgres --------------------------------------------------------
# Pooled HTTP endpoint for the app (drizzle-orm/neon-http).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Unpooled endpoint for drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# ---- Better Auth ----------------------------------------------------------
# Generate one with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Public app URL — http://localhost:3000 in dev, your Vercel URL in prod.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: protect the demo account behind a real password instead of the
# invite-only default "codevault-demo".
DEMO_EMAIL=demo@codevault.dev
DEMO_PASSWORD=codevault-demo
